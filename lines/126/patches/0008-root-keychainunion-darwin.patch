
Darwin integration for the keychain-union trust model: enumerate the USER,
ADMIN and SYSTEM keychain trust domains with Keychain Access semantics -- user
settings override admin settings for the policy they cover, only settings for
the SSL policy (or for all policies) count, hostname-restricted settings are
skipped -- using Go 1.16/1.17's own pure-Go enumeration
(https://github.com/golang/go/blob/go1.17.13/src/crypto/x509/root_darwin.go,
Copyright The Go Authors, BSD-style license), and build the union anchor pool
via buildKeychainUnionPool; root_darwin.go's loadSystemRoots serves it. Reading
the USER domain does not prompt: user trust settings live in a root-owned file
securityd reads; the SecurityAgent prompt guards writes (verified on 10.9.5 in
ssh, GUI, root and launchd contexts).

Deviations from Go 1.17's code, each also noted in the source:
  - user -> admin fall-through: Go 1.17 consulted admin settings only when the
    user had none; here a user domain with no definitive result for SSL (other
    policies only, hostname-restricted, or Unspecified) falls through to the
    admin domain, as Apple evaluates it, so an admin "Never Trust" is not lost
    (golang.org/issue/38888). sslTrustSettingsResult is split in two for this:
    keychainUnionSSLTrustSettingsFromArray is its second half, unchanged.
  - SecCertificateCopyData replaces SecItemExport (exportCertificate).
  - Debug lines print the domain and index instead of cert.Subject.
  - The TrustRoot/TrustAsRoot/Deny/Unspecified result switch lives in
    buildKeychainUnionPool; enumeration only returns entries.
  - A domain that fails to enumerate is skipped instead of failing the whole
    load, where Go 1.17 failed it: fail-open for that domain's certificates,
    while the CA bundle still serves.

Go's own verifier is the default; GODEBUG=x509usefallbackroots=0 selects
Apple's, except below macOS 10.14, where this file still forces Go's verifier
because upstream's systemVerify crashes there. (The crash is not
Security.framework's: SecTrustCreateWithCertificates is handed a policies
CFArray with no retain callbacks. Passing the SecPolicyRef directly works on
10.9.) @SSLDIR@ is substituted at build time with the toolchain's CA-bundle
directory. All identifiers unexported.

--- src/crypto/x509/root_keychainunion_darwin.go.orig
+++ src/crypto/x509/root_keychainunion_darwin.go
@@ -0,0 +1,288 @@
+//go:build darwin
+
+package x509
+
+import (
+	"crypto/x509/internal/macos"
+	"errors"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// CA-bundle discovery mirrors root_bsd.go's certFiles, plus the toolchain's own
+// CA-bundle path (@SSLDIR@ is substituted at build time).
+var keychainUnionBundlePaths = []string{
+	"@SSLDIR@/certs/ca-certificates.crt",
+	"/usr/local/etc/openssl/cert.pem",
+	"/etc/openssl/certs/ca-certificates.crt",
+	"/etc/ssl/certs/ca-certificates.crt",
+	"/etc/ssl/cert.pem",
+}
+
+var keychainUnionDebug = strings.Contains(os.Getenv("GODEBUG"), "x509roots=1")
+
+// keychainUnionEnumerateKeychain lists every certificate that has trust settings in
+// the user, admin and system domains, with its effective result for the SSL policy.
+//
+// Adapted from Go 1.16/1.17's crypto/x509/root_darwin.go loadSystemRoots
+// (Copyright 2020 The Go Authors, BSD-style license):
+// https://github.com/golang/go/blob/go1.17.13/src/crypto/x509/root_darwin.go
+// Changes from Go 1.17:
+//   - it returns entries for buildKeychainUnionPool, which applies Go 1.17's
+//     result switch (TrustRoot, TrustAsRoot, Deny, Unspecified), instead of
+//     building a pool itself;
+//   - SecCertificateCopyData replaces SecItemExport (exportCertificate);
+//   - debug lines print the domain and index instead of cert.Subject;
+//   - a domain that fails to enumerate is skipped instead of failing the whole
+//     load: fail-open for that domain's certificates, while the CA bundle still
+//     serves;
+//   - keychainUnionSSLTrustSettingsResult falls through from the user to the
+//     admin domain when the user's settings have no definitive result for the
+//     SSL policy (see there);
+//   - identifiers are prefixed.
+func keychainUnionEnumerateKeychain() []keychainUnionTrustEntry {
+	var out []keychainUnionTrustEntry
+
+	// macOS has three trust domains: one for CAs added by users to their
+	// "login" keychain, one for CAs added by Admins to the "System" keychain,
+	// and one for the CAs that ship with the OS.
+	for _, domain := range []macos.SecTrustSettingsDomain{
+		macos.SecTrustSettingsDomainUser,
+		macos.SecTrustSettingsDomainAdmin,
+		macos.SecTrustSettingsDomainSystem,
+	} {
+		certs, err := macos.SecTrustSettingsCopyCertificates(domain)
+		if err != nil {
+			if keychainUnionDebug && err != macos.ErrNoTrustSettings {
+				fmt.Fprintf(os.Stderr, "crypto/x509: domain %d: %v\n", domain, err)
+			}
+			continue
+		}
+
+		for i := 0; i < macos.CFArrayGetCount(certs); i++ {
+			c := macos.CFArrayGetValueAtIndex(certs, i)
+			der, err := macos.SecCertificateCopyData(c)
+			if err != nil {
+				if keychainUnionDebug {
+					fmt.Fprintf(os.Stderr, "crypto/x509: domain %d, certificate #%d: %v\n", domain, i, err)
+				}
+				continue
+			}
+
+			var result macos.SecTrustSettingsResult
+			if domain == macos.SecTrustSettingsDomainSystem {
+				// Certs found in the system domain are always trusted. If the user
+				// configures "Never Trust" on such a cert, it will also be found in the
+				// admin or user domain, causing it to be added to the distrust set.
+				result = macos.SecTrustSettingsResultTrustRoot
+			} else {
+				result, err = keychainUnionSSLTrustSettingsResult(c)
+				if err != nil {
+					if keychainUnionDebug {
+						fmt.Fprintf(os.Stderr, "crypto/x509: domain %d, certificate #%d trust settings: %v\n", domain, i, err)
+					}
+					continue
+				}
+				if keychainUnionDebug {
+					fmt.Fprintf(os.Stderr, "crypto/x509: domain %d, certificate #%d trust settings: %d\n", domain, i, result)
+				}
+			}
+			out = append(out, keychainUnionTrustEntry{der: der, result: int(result)})
+		}
+		macos.CFRelease(certs)
+	}
+	return out
+}
+
+// keychainUnionSSLTrustSettingsResult obtains the final kSecTrustSettingsResult value for a
+// certificate in the user or admin domain, combining usage constraints for the
+// SSL SecTrustSettingsPolicy,
+//
+// It ignores SecTrustSettingsKeyUsage and kSecTrustSettingsAllowedError, and
+// doesn't support kSecTrustSettingsDefaultRootCertSetting.
+//
+// https://developer.apple.com/documentation/security/1400261-sectrustsettingscopytrustsetting
+func keychainUnionSSLTrustSettingsResult(cert macos.CFRef) (macos.SecTrustSettingsResult, error) {
+	// In Apple's implementation user trust settings override admin trust settings
+	// (which themselves override system trust settings). If SecTrustSettingsCopyTrustSettings
+	// fails, or returns a NULL trust settings, when looking for the user trust
+	// settings then fallback to checking the admin trust settings.
+	//
+	// See Security-59306.41.2/trust/headers/SecTrustSettings.h for a description of
+	// the trust settings overrides, and SecLegacyAnchorSourceCopyUsageConstraints in
+	// Security-59306.41.2/trust/trustd/SecCertificateSource.c for a concrete example
+	// of how Apple applies the override in the case of NULL trust settings, or non
+	// success errors.
+	for _, domain := range []macos.SecTrustSettingsDomain{
+		macos.SecTrustSettingsDomainUser,
+		macos.SecTrustSettingsDomainAdmin,
+	} {
+		trustSettings, err := macos.SecTrustSettingsCopyTrustSettings(cert, domain)
+		if err != nil || trustSettings == 0 {
+			if keychainUnionDebug && err != macos.ErrNoTrustSettings {
+				name := "SecTrustSettingsDomainUser"
+				if domain == macos.SecTrustSettingsDomainAdmin {
+					name = "SecTrustSettingsDomainAdmin"
+				}
+				fmt.Fprintf(os.Stderr, "crypto/x509: SecTrustSettingsCopyTrustSettings for %s failed: %s\n", name, err)
+			}
+			continue
+		}
+		result, err := keychainUnionSSLTrustSettingsFromArray(trustSettings)
+		if err != nil || result != macos.SecTrustSettingsResultUnspecified {
+			return result, err
+		}
+		// Deviation from Go 1.17, which consulted the admin settings only when the
+		// user had none at all: Apple evaluates the next domain when a domain has no
+		// definitive entry for the policy, so a user domain whose settings give no
+		// result for SSL (settings only for other policies, hostname-restricted, or
+		// an explicit Unspecified) falls through to the admin domain, and an admin
+		// "Never Trust" for SSL is not silently lost (golang.org/issue/38888).
+	}
+
+	// If there are neither user nor admin trust settings for a certificate returned
+	// from SecTrustSettingsCopyCertificates Apple returns kSecTrustSettingsResultInvalid,
+	// as this method is intended to return certificates _which have trust settings_.
+	// The most likely case for this being triggered is that the existing trust settings
+	// are invalid and cannot be properly parsed. In this case SecTrustSettingsCopyTrustSettings
+	// returns errSecInvalidTrustSettings. The existing cgo implementation returns
+	// kSecTrustSettingsResultUnspecified in this case, which mostly matches the Apple
+	// implementation because we don't do anything with certificates marked with this
+	// result.
+	//
+	// See SecPVCGetTrustSettingsResult in Security-59306.41.2/trust/trustd/SecPolicyServer.c
+	return macos.SecTrustSettingsResultUnspecified, nil
+}
+
+// keychainUnionSSLTrustSettingsFromArray returns the kSecTrustSettingsResult for the SSL
+// policy from one domain's trust settings array, and releases the array. Its body is
+// the second half of Go 1.17's sslTrustSettingsResult, unchanged.
+func keychainUnionSSLTrustSettingsFromArray(trustSettings macos.CFRef) (macos.SecTrustSettingsResult, error) {
+	defer macos.CFRelease(trustSettings)
+
+	// "An empty trust settings array means 'always trust this certificate' with an
+	// overall trust setting for the certificate of kSecTrustSettingsResultTrustRoot."
+	if macos.CFArrayGetCount(trustSettings) == 0 {
+		return macos.SecTrustSettingsResultTrustRoot, nil
+	}
+
+	isSSLPolicy := func(policyRef macos.CFRef) bool {
+		properties := macos.SecPolicyCopyProperties(policyRef)
+		defer macos.CFRelease(properties)
+		if v, ok := macos.CFDictionaryGetValueIfPresent(properties, macos.SecPolicyOid); ok {
+			return macos.CFEqual(v, macos.CFRef(macos.SecPolicyAppleSSL))
+		}
+		return false
+	}
+
+	for i := 0; i < macos.CFArrayGetCount(trustSettings); i++ {
+		tSetting := macos.CFArrayGetValueAtIndex(trustSettings, i)
+
+		// First, check if this trust setting is constrained to a non-SSL policy.
+		if policyRef, ok := macos.CFDictionaryGetValueIfPresent(tSetting, macos.SecTrustSettingsPolicy); ok {
+			if !isSSLPolicy(policyRef) {
+				continue
+			}
+		}
+
+		// Then check if it is restricted to a hostname, so not a root.
+		if _, ok := macos.CFDictionaryGetValueIfPresent(tSetting, macos.SecTrustSettingsPolicyString); ok {
+			continue
+		}
+
+		cfNum, ok := macos.CFDictionaryGetValueIfPresent(tSetting, macos.SecTrustSettingsResultKey)
+		// "If this key is not present, a default value of kSecTrustSettingsResultTrustRoot is assumed."
+		if !ok {
+			return macos.SecTrustSettingsResultTrustRoot, nil
+		}
+		result, err := macos.CFNumberGetValue(cfNum)
+		if err != nil {
+			return 0, err
+		}
+
+		// If multiple dictionaries match, we are supposed to "OR" them,
+		// the semantics of which are not clear. Since TrustRoot and TrustAsRoot
+		// are mutually exclusive, Deny should probably override, and Invalid and
+		// Unspecified be overridden, approximate this by stopping at the first
+		// TrustRoot, TrustAsRoot or Deny.
+		switch r := macos.SecTrustSettingsResult(result); r {
+		case macos.SecTrustSettingsResultTrustRoot,
+			macos.SecTrustSettingsResultTrustAsRoot,
+			macos.SecTrustSettingsResultDeny:
+			return r, nil
+		}
+	}
+
+	// If trust settings are present, but none of them match the policy...
+	// the docs don't tell us what to do.
+	//
+	// "Trust settings for a given use apply if any of the dictionaries in the
+	// certificate’s trust settings array satisfies the specified use." suggests
+	// that it's as if there were no trust settings at all, so we should maybe
+	// fallback to the admin trust settings? TODO(golang.org/issue/38888).
+
+	return macos.SecTrustSettingsResultUnspecified, nil
+}
+
+// keychainUnionReadDirNames lists a directory's entry names (for SSL_CERT_DIR).
+func keychainUnionReadDirNames(dir string) ([]string, error) {
+	ents, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, err
+	}
+	names := make([]string, 0, len(ents))
+	for _, e := range ents {
+		names = append(names, e.Name())
+	}
+	return names, nil
+}
+
+// keychainUnionLoadSystemRoots builds the keychain-union root store. loadSystemRoots calls it
+// under systemRootsMu the first time a verification needs the system roots -- not at program
+// start -- which also records the distrust set for verify.go's veto.
+func keychainUnionLoadSystemRoots() (*CertPool, error) {
+	paths := keychainUnionResolveBundlePaths(os.Getenv, keychainUnionReadDirNames, keychainUnionBundlePaths)
+	pool, distrust := buildKeychainUnionPool(keychainUnionEnumerateKeychain(), paths)
+	keychainUnionDistrusted = distrust
+	if pool.len() == 0 {
+		return nil, errors.New("x509: no trusted keychain certificates and no CA bundle found")
+	}
+	return pool, nil
+}
+
+// keychainUnionNativeVerifier reports whether Apple's verifier was selected with
+// GODEBUG=x509usefallbackroots=0.
+func keychainUnionNativeVerifier() bool {
+	return x509usefallbackroots.Value() == "0" && !keychainUnionNativeVerifierBroken()
+}
+
+// keychainUnionNativeVerifierBroken reports whether Apple's SecTrust engine is unusable
+// from Go on this macOS (true on < 10.14, where upstream's systemVerify crashes). Reads
+// ProductVersion from SystemVersion.plist, present on every macOS.
+func keychainUnionNativeVerifierBroken() bool {
+	data, err := os.ReadFile("/System/Library/CoreServices/SystemVersion.plist")
+	if err != nil {
+		return false
+	}
+	s := string(data)
+	i := strings.Index(s, "<key>ProductVersion</key>")
+	if i < 0 {
+		return false
+	}
+	rest := s[i:]
+	a := strings.Index(rest, "<string>")
+	b := strings.Index(rest, "</string>")
+	if a < 0 || b < 0 || b < a {
+		return false
+	}
+	ver := rest[a+len("<string>") : b]
+	parts := strings.SplitN(ver, ".", 3)
+	if len(parts) < 2 {
+		return false
+	}
+	major, _ := strconv.Atoi(parts[0])
+	minor, _ := strconv.Atoi(parts[1])
+	return major < 10 || (major == 10 && minor < 14)
+}
