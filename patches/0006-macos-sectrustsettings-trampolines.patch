Assembly trampolines for the wrappers restored in the companion security.go
patch (they are address-taken from Go code): the standard NOSPLIT JMP stubs
(byte-for-byte Go's own from Go 1.24 and Go 1.18, plus one in the same form for
SecTrustGetCssmResultCode):

  https://github.com/golang/go/blob/go1.24.13/src/crypto/x509/internal/macos/security.s
  https://github.com/golang/go/blob/go1.18.10/src/crypto/x509/internal/macos/security.s

--- src/crypto/x509/internal/macos/security.s.orig
+++ src/crypto/x509/internal/macos/security.s
@@ -25,3 +25,15 @@
 	JMP x509_SecCertificateCopyData(SB)
 TEXT ·x509_SecTrustCopyCertificateChain_trampoline(SB),NOSPLIT,$0-0
 	JMP x509_SecTrustCopyCertificateChain(SB)
+TEXT ·x509_SecTrustSettingsCopyCertificates_trampoline(SB),NOSPLIT,$0-0
+	JMP	x509_SecTrustSettingsCopyCertificates(SB)
+TEXT ·x509_SecTrustSettingsCopyTrustSettings_trampoline(SB),NOSPLIT,$0-0
+	JMP	x509_SecTrustSettingsCopyTrustSettings(SB)
+TEXT ·x509_SecPolicyCopyProperties_trampoline(SB),NOSPLIT,$0-0
+	JMP	x509_SecPolicyCopyProperties(SB)
+TEXT ·x509_SecTrustGetCertificateCount_trampoline(SB),NOSPLIT,$0-0
+	JMP x509_SecTrustGetCertificateCount(SB)
+TEXT ·x509_SecTrustGetCertificateAtIndex_trampoline(SB),NOSPLIT,$0-0
+	JMP x509_SecTrustGetCertificateAtIndex(SB)
+TEXT ·x509_SecTrustGetCssmResultCode_trampoline(SB),NOSPLIT,$0-0
+	JMP x509_SecTrustGetCssmResultCode(SB)
